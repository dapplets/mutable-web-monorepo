# Required
DOMAIN_NAME=example.org
SSL_EMAIL=example@example.com
TELEGRAM_BOT_TOKEN=1234567890:deadbeef
OPENAI_API_KEY=sk-proj-1234567890
NEAR_AI_API_KEY={"account_id":"example.near","public_key":"ed25519:cafebabe","signature":"deadbeef==","callback_url":"https://app.near.ai/sign-in/callback","message":"Welcome to NEAR AI Hub!","recipient":"ai.near","nonce":"0000000000"}

# Optional
# TELEGRAM_MONITORING_CHAT_ID=-1234567890
# TELEGRAM_MONITORING_TOPIC_ID=123
# NFT_CONTRACT_ID=nft.example.near
# NFT_CONTRACT_OWNER_ID=owner.example.near
# NFT_CONTRACT_OWNER_PRIVATE_KEY=ed25519:deadbeef
# REWARD_ACCOUNT_PRIVATE_KEY=ed25519:deadbeef
# REWARD_ACCOUNT_ID=fund.example.near

# Default values
NEAR_LOGIN_CONTRACT_ID=social.dapplets.near
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=aigency
POSTGRES_SCHEMA=public
NEAR_NETWORK_ID=mainnet
NEAR_NODE_URL=https://rpc.mainnet.near.org
NEAR_WALLET_URL=https://app.mynearwallet.com
NEAR_HELPER_URL=https://helper.mainnet.near.org
BUG_REWARD_AMOUNT=100000000000000000000
USAGE_REWARD_AMOUNT=100000000000000000000
SUBDOMAIN_API=api
SUBDOMAIN_N8N=n8n
SUBDOMAIN_TGAPP=tgapp
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_POSTGRES_DB=n8n
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
TZ=Etc/UTC
GENERIC_TIMEZONE=Etc/UTC

# It's generated by generate-env.sh
AIGENCY_API_KEY=__SECRET__
N8N_ENCRYPTION_KEY=__SECRET__
N8N_USER_MANAGEMENT_JWT_SECRET=__SECRET__
POSTGRES_PASSWORD=__SECRET__