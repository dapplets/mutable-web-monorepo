    },
    {
      "parameters": {
        "jsCode": "// Get the remindertime from the input JSON\nconst remindertimeString = $json.remindertime;\n\n// Check if remindertimeString is valid.  If not, return an error.\nif (!remindertimeString) {\n  return { error: \"remindertime is missing or invalid\" };\n}\n\n// Convert the remindertime string to a Date object\nconst remindertime = new Date(remindertimeString);\n\n// Get the current time\nconst now = new Date();\n\n// Calculate the difference in milliseconds\nlet diff = remindertime.getTime() - now.getTime();\n\nlet output = \"\";\n\nif (diff < 0) {\n  output = \"It's already happened\";\n} else {\n  // Calculate days, hours, and minutes\n  const days = Math.floor(diff / (1000 * 60 * 60 * 24));\n  diff -= days * (1000 * 60 * 60 * 24);\n  const hours = Math.floor(diff / (1000 * 60 * 60));\n  diff -= hours * (1000 * 60 * 60);\n  const minutes = Math.floor(diff / (1000 * 60));\n\n  // Build the output string\n  if (days > 0) {\n    output += days + \" d. \";\n  }\n  if (hours > 0) {\n    output += hours + \" h. \";\n  }\n  output += minutes + \" m.\";\n  output = \"\" + output;\n}\n\n// Return the result\nreturn { reminder: output };"
      },
      "type": "n8n-nodes-base.code",
