        "inputSchema": "{\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"type\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"task\",\n          \"reminder\"\n        ],\n        \"description\": \"Тип объекта: задача или напоминание\"\n      },\n      \"task\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"description\": {\n            \"type\": \"string\",\n            \"description\": \"Описание задачи для выполнения LLM\"\n          },\n          \"isDone\": {\n            \"type\": \"boolean\",\n            \"description\": \"Статус выполнения задачи\",\n            \"default\": false\n          }\n        },\n        \"required\": [\n          \"description\"\n        ],\n        \"description\": \"Описание задачи (если type = 'task')\"\n      },\n      \"reminder\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"description\": {\n            \"type\": \"string\",\n            \"description\": \"Описание напоминания для пользователя\"\n          },\n          \"reminderTime\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\",\n            \"description\": \"Время отправки напоминания в формате ISO 8601\"\n          }\n        },\n        \"required\": [\n          \"description\",\n          \"reminderTime\"\n        ],\n        \"description\": \"Описание напоминания (если type = 'reminder')\"\n      }\n    },\n    \"required\": [\n      \"type\"\n    ]\n  }\n}",
        "schemaType": "manual"
      },
