      "id": "0500c3b7-3bc1-41c1-bb6f-3a629a0455eb",
      "name": "Code",
      "parameters": {
        "jsCode": "// Process each input item\nconst newItems = items.map(item => {\n  // Create a shallow copy of the item to avoid modifying the original\n  const newItem = { json: { ...item.json } };\n\n  // Check if the item has the expected structure\n  if (newItem.json.object === \"list\" && Array.isArray(newItem.json.data)) {\n    newItem.json.data = newItem.json.data.map(dataEntry => {\n      // Check if the data entry has a \"content\" array\n      if (dataEntry.content && Array.isArray(dataEntry.content)) {\n        dataEntry.content = dataEntry.content.map(contentItem => {\n          // If the content item is of type \"text\" and has a text.value property as a string\n          if (contentItem.type === \"text\" && contentItem.text && typeof contentItem.text.value === \"string\") {\n            try {\n              // Try parsing the JSON string to convert it into an object\n              contentItem.text.value = JSON.parse(contentItem.text.value);\n            } catch (error) {\n              // If parsing fails, record an error message inside the text object\n              contentItem.text.parseError = error.message;\n            }\n          }\n          return contentItem;\n        });\n      }\n      return dataEntry;\n    });\n  }\n  return newItem;\n});\n\nreturn newItems;\n"
      },
      "position": [
        1020,
        -120
      ],
